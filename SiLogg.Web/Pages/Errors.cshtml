@page
@model ErrorsModel
@{
    ViewData["Title"] = "Felrapport";
}
<header class="page-heading">
    <div>
        <p class="eyebrow">Misslyckade skrivningar till SI-pinne</p>
        <h1>Felrapport</h1>
    </div><a class="button button-secondary" asp-page="/Index">Sök stämplingar</a>
</header>
<form method="get" class="filters">
    <div class="field"><label asp-for="ErrorCode">Felkod</label><select asp-for="ErrorCode">
        <option value="">Alla</option>@foreach(var code in Model.ErrorCodes){
        <option value="@code">@code</option>
    }
</select></div>
<div class="field"><label asp-for="Date">Datum</label><input asp-for="Date" type="date" lang="sv-SE" /></div>
<div class="field"><label asp-for="CodeNumber">Kontrollkod</label><input asp-for="CodeNumber" inputmode="numeric" />
</div>
<div class="field"><label asp-for="Siid">SIID</label><input asp-for="Siid" inputmode="numeric" /></div>
<button class="button button-primary" type="submit">Filtrera</button>
</form>
<div class="result-summary">
    <h2>Registrerade fel</h2><span>@Model.Errors.Count träffar</span>
</div>
@if (Model.Errors.Count == 0)
{
    <div class="empty-state">Inga fel matchar filtret. Importera kontrollfiler på söksidan om
        databasen är tom.</div>
    }
else
    {
        @foreach (var dateGroup in Model.Errors.GroupBy(error => error.Date).OrderBy(group => group.Key))
        {
            <div class="competition">
                <h3>@(string.IsNullOrWhiteSpace(dateGroup.Key) ? "Okänt datum" : dateGroup.Key)</h3>
                <div class="table-wrap">
                    <table data-sortable>
                        <thead>
                            <tr>
                                <th>Fel</th>
                                <th>SIID</th>
                                <th>Kontroll</th>
                                <th>Före</th>
                                <th>Efter</th>
                                <th>Källa</th>
                                <th data-no-sort>Detaljer</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var error in dateGroup)
                            {
                                var operatingMode = error.RawData.GetValueOrDefault("Operating mode");
                                <tr>
                                    <td data-sort-value="@error.ErrorCode"><span class="error-code">@error.ErrorCode</span>
                                        <div>@error.Description</div>
                                    </td>
                                    <td class="mono" data-sort-value="@error.Siid">@error.Siid</td>
                                    <td data-sort-value="@error.CodeNumber">
                                        <strong>@error.CodeNumber</strong>@if(!string.IsNullOrWhiteSpace(operatingMode)){
                                        <span
                                        class="mode-label">@operatingMode</span>
                                    }
                                </td>
                                <td class="neighbor" data-sort-value="@error.PreviousPunch?.ControlTime">@if(error.PreviousPunch is
                                    null){
                                        <span>Saknas</span>
                                    }else
                                    {

                                        <strong
                                        class="mono">@error.PreviousPunch.ControlTime</strong><span>SIID
                                        @error.PreviousPunch.Siid</span>
                                    }
                                </td>
                                <td class="neighbor" data-sort-value="@error.NextPunch?.ControlTime">@if(error.NextPunch is
                                    null){
                                        <span>Saknas</span>
                                    }else
                                    {

                                        <strong
                                        class="mono">@error.NextPunch.ControlTime</strong><span>SIID @error.NextPunch.Siid</span>
                                    }
                                </td>
                                <td data-sort-value="@error.SourceFile @error.RowNumber">@error.SourceFile<br /><span
                                    class="mono">rad @error.RowNumber</span></td>
                                    <td>
                                        <details>
                                            <summary>Rådata</summary>
                                            <dl class="raw-grid">@foreach(var item in error.RawData){
                                                <dt>@item.Key</dt>
                                                <dd>@(string.IsNullOrEmpty(item.Value) ? "–" : item.Value)</dd>
                                            }
                                        </dl>
                                    </details>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}